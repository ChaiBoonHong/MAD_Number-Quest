<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_game_gradient"
    android:fitsSystemWindows="true"
    tools:context=".PlaceValueActivity">

    <LinearLayout android:id="@+id/gameHeader" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="@dimen/game_screen_margin" android:layout_marginTop="@dimen/game_header_top_margin" android:layout_marginEnd="@dimen/game_screen_margin" android:gravity="center_vertical" android:orientation="horizontal" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent">
        <com.google.android.material.button.MaterialButton android:id="@+id/btnBack" style="@style/Widget.NumberQuest.BackButton" android:layout_width="wrap_content" android:layout_height="52dp" android:text="@string/back" app:icon="@android:drawable/ic_media_previous" app:iconTint="@color/game_blue_dark" />
        <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
        <TextView android:id="@+id/tvScore" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="8dp" android:background="@drawable/bg_status_blue" android:text="@string/score_initial" android:textColor="@color/game_blue_dark" android:textSize="16sp" android:textStyle="bold" android:visibility="gone" />
        <TextView android:id="@+id/tvTimer" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/bg_status_blue" android:text="@string/time_initial" android:textColor="@color/game_blue_dark" android:textSize="16sp" android:textStyle="bold" android:visibility="gone" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView android:id="@+id/questionScroll" android:layout_width="0dp" android:layout_height="0dp" android:fillViewport="true" app:layout_constraintBottom_toTopOf="@id/answerTray" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toBottomOf="@id/gameHeader">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_horizontal" android:orientation="vertical" android:paddingStart="@dimen/game_screen_margin" android:paddingTop="14dp" android:paddingEnd="@dimen/game_screen_margin" android:paddingBottom="16dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/place_value_title" android:textColor="@color/game_green" android:textSize="16sp" android:textStyle="bold" />
            <TextView android:id="@+id/tvInstruction" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:gravity="center" android:text="@string/how_many_tens_ones" android:textColor="@color/game_navy" android:textSize="26sp" android:textStyle="bold" />

            <com.google.android.material.card.MaterialCardView android:id="@+id/borderContainer" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" app:cardBackgroundColor="@color/game_surface" app:cardCornerRadius="28dp" app:cardElevation="3dp" app:strokeColor="@color/game_green" app:strokeWidth="2dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="14dp">
                    <TextView android:id="@+id/tvTensCount" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:textColor="@color/game_green" android:textSize="18sp" android:textStyle="bold" tools:text="8 tens" />
                    <com.google.android.flexbox.FlexboxLayout android:id="@+id/tensContainerLayout" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:minHeight="120dp" app:alignContent="center" app:alignItems="center" app:flexWrap="wrap" app:justifyContent="center" />
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginVertical="8dp" android:background="@color/game_outline" />
                    <TextView android:id="@+id/tvOnesCount" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:textColor="@color/game_blue_dark" android:textSize="18sp" android:textStyle="bold" tools:text="3 ones" />
                    <com.google.android.flexbox.FlexboxLayout android:id="@+id/onesContainerLayout" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:minHeight="48dp" app:alignContent="center" app:alignItems="center" app:flexWrap="wrap" app:justifyContent="center" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.card.MaterialCardView android:id="@+id/answerTray" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_margin="@dimen/answer_tray_margin" app:cardBackgroundColor="@color/game_surface" app:cardCornerRadius="28dp" app:cardElevation="6dp" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" app:strokeColor="@color/game_outline" app:strokeWidth="1dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_horizontal" android:orientation="vertical" android:padding="@dimen/answer_tray_padding">
            <TextView android:id="@+id/tvFeedback" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_feedback" android:gravity="center" android:minHeight="46dp" android:textColor="@color/game_navy" android:textSize="17sp" android:textStyle="bold" android:visibility="invisible" tools:text="Eight tens make eighty." />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:gravity="center" android:text="@string/choose_answer" android:textColor="@color/game_text_muted" android:textSize="14sp" android:textStyle="bold" />
            <GridLayout android:id="@+id/optionsContainerLayout" android:layout_width="match_parent" android:layout_height="wrap_content" android:columnCount="2" android:rowCount="2" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</androidx.constraintlayout.widget.ConstraintLayout>
