<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_game_gradient"
    android:fillViewport="true"
    android:fitsSystemWindows="true"
    tools:context=".RecognitionActivity">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_horizontal" android:orientation="vertical" android:paddingStart="18dp" android:paddingTop="14dp" android:paddingEnd="18dp" android:paddingBottom="28dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
            <com.google.android.material.button.MaterialButton android:id="@+id/btnBack" style="@style/Widget.NumberQuest.BackButton" android:layout_width="wrap_content" android:layout_height="52dp" android:text="@string/back" app:icon="@android:drawable/ic_media_previous" app:iconTint="@color/game_blue_dark" />
            <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
            <TextView android:id="@+id/tvScore" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="8dp" android:background="@drawable/bg_status_blue" android:text="@string/score_initial" android:textColor="@color/game_blue_dark" android:textSize="16sp" android:textStyle="bold" android:visibility="gone" />
            <TextView android:id="@+id/tvTimer" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/bg_status_blue" android:text="@string/time_initial" android:textColor="@color/game_blue_dark" android:textSize="16sp" android:textStyle="bold" android:visibility="gone" />
        </LinearLayout>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="@string/number_recognition_title" android:textColor="@color/game_purple" android:textSize="16sp" android:textStyle="bold" />
        <TextView android:id="@+id/tvTargetPrompt" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:gravity="center" android:text="@string/find_the_number" android:textColor="@color/game_navy" android:textSize="26sp" android:textStyle="bold" />
        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="190dp" android:layout_marginTop="18dp" app:cardBackgroundColor="@color/game_surface" app:cardCornerRadius="28dp" app:cardElevation="3dp" app:strokeColor="@color/game_purple" app:strokeWidth="2dp">
            <TextView android:id="@+id/tvTarget" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:padding="24dp" android:text="@string/zero" android:textColor="@color/game_navy" android:textSize="38sp" android:textStyle="bold" />
        </com.google.android.material.card.MaterialCardView>
        <TextView android:id="@+id/tvFeedback" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:background="@drawable/bg_feedback" android:gravity="center" android:minHeight="46dp" android:textColor="@color/game_navy" android:textSize="19sp" android:textStyle="bold" android:visibility="invisible" tools:text="Great job! ⭐" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:gravity="center" android:text="@string/choose_answer" android:textColor="@color/game_text_muted" android:textSize="14sp" android:textStyle="bold" />
        <GridLayout android:id="@+id/optionsContainerLayout" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:columnCount="2" android:padding="4dp" android:rowCount="2" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
