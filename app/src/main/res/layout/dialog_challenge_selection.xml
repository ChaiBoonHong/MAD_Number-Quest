<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:foregroundGravity="center"
    android:padding="22dp">
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        app:cardBackgroundColor="@color/game_surface"
        app:cardCornerRadius="32dp"
        app:cardElevation="10dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="22dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                <TextView android:id="@+id/tvDialogTitle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/choose_challenge" android:textColor="@color/game_navy" android:textSize="27sp" android:textStyle="bold" />
                <ImageButton android:id="@+id/btnClose" android:layout_width="52dp" android:layout_height="52dp" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="@string/close" android:padding="13dp" android:src="@android:drawable/ic_menu_close_clear_cancel" app:tint="@color/game_text_muted" />
            </LinearLayout>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="@string/choose_challenge_hint" android:textColor="@color/game_text_muted" android:textSize="15sp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btnTimeAttack" android:layout_width="match_parent" android:layout_height="88dp" android:layout_marginTop="24dp" android:gravity="center_vertical" android:paddingHorizontal="22dp" android:text="@string/time_attack_desc" android:textAllCaps="false" android:textSize="20sp" android:textStyle="bold" app:backgroundTint="@color/game_green" app:cornerRadius="22dp" app:icon="@android:drawable/ic_lock_idle_alarm" app:iconGravity="textStart" app:iconPadding="14dp" app:iconSize="28dp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="18dp" android:layout_marginTop="5dp" android:text="@string/time_attack_subtitle" android:textColor="@color/game_text_muted" android:textSize="13sp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btnScoreAttack" android:layout_width="match_parent" android:layout_height="88dp" android:layout_marginTop="18dp" android:gravity="center_vertical" android:paddingHorizontal="22dp" android:text="@string/score_attack_desc" android:textAllCaps="false" android:textSize="20sp" android:textStyle="bold" app:backgroundTint="@color/game_blue" app:cornerRadius="22dp" app:icon="@android:drawable/btn_star_big_on" app:iconGravity="textStart" app:iconPadding="14dp" app:iconSize="28dp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="18dp" android:layout_marginTop="5dp" android:layout_marginBottom="4dp" android:text="@string/score_attack_subtitle" android:textColor="@color/game_text_muted" android:textSize="13sp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</FrameLayout>
