<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:padding="24dp">
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="center"
        app:cardBackgroundColor="@color/game_surface" app:cardCornerRadius="28dp" app:cardElevation="8dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
            <TextView android:id="@+id/tvConfirmTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:textColor="@color/game_navy" android:textSize="26sp" android:textStyle="bold" />
            <TextView android:id="@+id/tvConfirmMessage" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center" android:textColor="@color/game_text_muted" android:textSize="16sp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btnConfirmPositive" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="22dp" android:textAllCaps="false" android:textStyle="bold" app:cornerRadius="18dp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btnConfirmNegative" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="10dp" android:textAllCaps="false" android:textStyle="bold" app:cornerRadius="18dp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</FrameLayout>
