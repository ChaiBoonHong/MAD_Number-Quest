<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_game_gradient"
    android:fitsSystemWindows="true">
    <com.google.android.material.button.MaterialButton android:id="@+id/btnBack" style="@style/Widget.NumberQuest.BackButton" android:layout_width="wrap_content" android:layout_height="52dp" android:layout_marginStart="18dp" android:layout_marginTop="14dp" android:text="@string/back" app:icon="@android:drawable/ic_media_previous" app:iconTint="@color/game_blue_dark" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" />
    <TextView android:id="@+id/tvHistoryTitle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="18dp" android:layout_marginTop="22dp" android:layout_marginEnd="18dp" android:text="@string/game_history" android:textColor="@color/game_navy" android:textSize="30sp" android:textStyle="bold" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toBottomOf="@id/btnBack" />
    <com.google.android.material.card.MaterialCardView android:id="@+id/historyModeContainer" android:layout_width="0dp" android:layout_height="64dp" android:layout_marginStart="18dp" android:layout_marginTop="14dp" android:layout_marginEnd="18dp" app:cardBackgroundColor="@color/game_surface" app:cardCornerRadius="24dp" app:cardElevation="0dp" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toBottomOf="@id/tvHistoryTitle" app:strokeColor="@color/game_outline" app:strokeWidth="1dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="horizontal" android:padding="6dp">
            <com.google.android.material.button.MaterialButton android:id="@+id/btnHistoryFun" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="52dp" android:layout_marginEnd="3dp" android:layout_weight="1" android:checkable="true" android:checked="true" android:text="@string/fun_mode" android:textAllCaps="false" android:textColor="@color/mode_toggle_text" android:textSize="15sp" android:textStyle="bold" app:backgroundTint="@color/mode_toggle_background" app:cornerRadius="18dp" app:strokeColor="@color/mode_toggle_stroke" app:strokeWidth="1dp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btnHistoryChallenge" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="52dp" android:layout_marginStart="3dp" android:layout_weight="1" android:checkable="true" android:text="@string/challenge_mode" android:textAllCaps="false" android:textColor="@color/mode_toggle_text" android:textSize="15sp" android:textStyle="bold" app:backgroundTint="@color/mode_toggle_background" app:cornerRadius="18dp" app:strokeColor="@color/mode_toggle_stroke" app:strokeWidth="1dp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/rvHistory" android:layout_width="0dp" android:layout_height="0dp" android:clipToPadding="false" android:paddingStart="18dp" android:paddingTop="16dp" android:paddingEnd="18dp" android:paddingBottom="24dp" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toBottomOf="@id/historyModeContainer" tools:listitem="@layout/item_history" />
    <TextView android:id="@+id/tvEmptyHistory" android:layout_width="260dp" android:layout_height="wrap_content" android:gravity="center" android:text="@string/history_empty" android:textColor="@color/game_text_muted" android:textSize="18sp" android:textStyle="bold" android:visibility="gone" app:layout_constraintBottom_toBottomOf="@id/rvHistory" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="@id/rvHistory" />
</androidx.constraintlayout.widget.ConstraintLayout>
