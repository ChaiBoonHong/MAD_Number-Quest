<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="22dp">
    <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="center" app:cardBackgroundColor="@color/game_surface" app:cardCornerRadius="32dp" app:cardElevation="10dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="22dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                <TextView android:id="@+id/tvDialogTitle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/time_attack" android:textColor="@color/game_navy" android:textSize="27sp" android:textStyle="bold" />
                <ImageButton android:id="@+id/btnClose" android:layout_width="52dp" android:layout_height="52dp" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="@string/close" android:padding="13dp" android:src="@android:drawable/ic_menu_close_clear_cancel" app:tint="@color/game_text_muted" />
            </LinearLayout>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="@string/time_attack_hint" android:textColor="@color/game_text_muted" android:textSize="15sp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btn60s" android:layout_width="match_parent" android:layout_height="72dp" android:layout_marginTop="22dp" android:text="@string/sixty_seconds" android:textAllCaps="false" android:textSize="19sp" android:textStyle="bold" app:backgroundTint="@color/game_green" app:cornerRadius="22dp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:gravity="center" android:text="@string/sixty_seconds_hint" android:textColor="@color/game_text_muted" android:textSize="13sp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btn90s" android:layout_width="match_parent" android:layout_height="72dp" android:layout_marginTop="14dp" android:text="@string/ninety_seconds" android:textAllCaps="false" android:textSize="19sp" android:textStyle="bold" app:backgroundTint="@color/game_blue" app:cornerRadius="22dp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:gravity="center" android:text="@string/ninety_seconds_hint" android:textColor="@color/game_text_muted" android:textSize="13sp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btn120s" android:layout_width="match_parent" android:layout_height="72dp" android:layout_marginTop="14dp" android:text="@string/one_twenty_seconds" android:textAllCaps="false" android:textSize="19sp" android:textStyle="bold" app:backgroundTint="@color/game_purple" app:cornerRadius="22dp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:layout_marginBottom="4dp" android:gravity="center" android:text="@string/one_twenty_seconds_hint" android:textColor="@color/game_text_muted" android:textSize="13sp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</FrameLayout>
